# Optional override for local runtime data directory (DB, documents, exports, backups, Playwright browsers).
# Defaults to OS application data directory if unset:
#   macOS:   ~/Library/Application Support/PersonalJobCopilot
#   Windows: %LOCALAPPDATA%\PersonalJobCopilot
#   Linux:   $XDG_DATA_HOME/personal-job-copilot or ~/.local/share/personal-job-copilot
# APP_DATA_DIR=

# Local server bind and port (loopback only by default)
PORT=3000
# HOST=127.0.0.1

# Optional AI CLI / local endpoint defaults (can also be configured in Settings UI without an API key)
# Supported CLI presets: none, claude, codex, opencode, agy, gemini, custom, openai-compatible
AI_PROVIDER=none
AI_CLI_COMMAND=
AI_MODEL=
AI_BASE_URL=

# Optional opt-in Chromium executable override for PDF export (defaults to Playwright-managed browser)
# PDF_BROWSER_EXECUTABLE_PATH=

# Required only when Gmail OAuth token encryption is enabled in a later release
# APP_ENCRYPTION_KEY=
